# Copy this file to .env and fill in real values.
# Nothing in this app will use fabricated/simulated data once these are set —
# opportunities and earnings come only from networks with real keys configured below.

PORT=8787

# --- Settings page auth ---
# Required to use the in-app Settings page (enter CPX/BitLabs/Anthropic keys
# there instead of editing this file after deploy). Pick any long random
# string -- this is the "password" the Settings page asks for.
ADMIN_SETTINGS_TOKEN=

# Everything below can ALSO be set from the Settings page once the app is
# running -- these env vars are just the fallback / first-boot values.

# --- CPX Research (https://publisher.cpx-research.com) ---
# Dashboard -> Setup -> API : App ID + Secure Hash
CPX_APP_ID=
CPX_SECURE_HASH=
# Dashboard -> Setup -> Postback URL: point it at
#   https://your-domain.com/api/webhooks/cpx
CPX_POSTBACK_SECRET=

# --- BitLabs (https://publisher.bitlabs.ai) ---
BITLABS_API_TOKEN=
# Postback URL to configure in BitLabs dashboard:
#   https://your-domain.com/api/webhooks/bitlabs
BITLABS_POSTBACK_SECRET=

# --- AdGate Media (https://adgatemedia.com/publishers) ---
ADGATE_WALL_CODE=
ADGATE_API_KEY=
# Postback URL: https://your-domain.com/api/webhooks/adgate
ADGATE_POSTBACK_SECRET=

# --- Anthropic (for the AI opportunity-ranking/assistant features) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
